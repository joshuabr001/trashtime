{
  "name": "trashtime-api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node --env-file=.env -r ts-node/register src/main.ts",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.cjs",
    "start": "node dist/main.js",
    "migrate": "node --env-file=.env scripts/migrate.mjs",
    "simulate": "node --env-file=.env scripts/simulate.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "pg": "^8.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  }
}
